# Variables à créer dans Netlify > Site configuration > Environment variables
# (ne jamais les mettre dans le code ni dans config.js)

# Firebase : console Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=admirelle-b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@admirelle-b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# FedaPay : tableau de bord FedaPay > Paramètres > Clés API
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxx
FEDAPAY_ENV=sandbox
# FedaPay > Paramètres > Webhooks (après avoir créé le webhook)
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxxxxx

# Adresse du site (facultatif, sinon l'adresse Netlify est utilisée)
SITE_URL=https://www.admirelle-b.com

# Notifications e-mail (facultatif) : emailjs.com
EMAILJS_SERVICE_ID=service_xxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxx
NOTIFY_EMAIL=badmirelle@gmail.com
